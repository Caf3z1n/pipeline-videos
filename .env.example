# Nunca versione a chave real. Copie este arquivo para .env.
ELEVENLABS_API_KEY=

# Configure um voice ID disponível em sua própria conta ElevenLabs.
ELEVENLABS_VOICE_ID=oy1Z2MNJzUkfXcLIq8CS

# OAuth do YouTube. Prefira caminhos absolutos para arquivos fora do repositório.
YOUTUBE_CLIENT_SECRETS_FILE=
YOUTUBE_TOKEN_FILE=

# Executor remoto. Na VPS, aponte para pastas persistentes fora dos releases.
PIPELINE_VIDEOS_REMOTE_JOBS_DIR=
CODEX_BINARY=

# Registro Git compartilhado de passagens/temas. O local usa a URL SSH do repositório bare;
# a VPS usa o caminho absoluto do mesmo repositório. Em modo git, falhas bloqueiam a seleção.
PIPELINE_VIDEOS_CONTENT_REGISTRY_MODE=local
PIPELINE_VIDEOS_CONTENT_REGISTRY_REMOTE=
PIPELINE_VIDEOS_CONTENT_REGISTRY_REF=refs/heads/content-registry
PIPELINE_VIDEOS_CONTENT_REGISTRY_ENVIRONMENT=

# Modelo, formato e parâmetros de voz ficam no project.json de cada vídeo e podem ser alterados
# com `pipeline-videos audio configure`.
