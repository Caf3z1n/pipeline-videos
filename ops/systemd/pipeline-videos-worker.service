[Unit]
Description=Pipeline de vídeos - processa um job remoto
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/pipeline-videos/current
Environment=HOME=/home/deploy
Environment=PATH=/home/deploy/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PIPELINE_VIDEOS_REMOTE_JOBS_DIR=/home/deploy/pipeline-videos/shared/jobs
Environment=YOUTUBE_TOKEN_FILE=/home/deploy/.config/pipeline-videos/youtube/token.json
EnvironmentFile=/home/deploy/pipeline-videos/shared/.env
ExecStart=/home/deploy/pipeline-videos/bin/video-job work-once
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUWeight=20
MemoryHigh=2400M
MemoryMax=3000M
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
TimeoutStartSec=8h
KillMode=mixed

[Install]
WantedBy=multi-user.target
